# Copia este archivo como .env y llena tus propios valores.

DATABASE_URL="file:./dev.db"

# Auth.js — genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth (Google Cloud Console > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple OAuth (Apple Developer > Certificates, Identifiers & Profiles)
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Cuenta bancaria propia donde tus suscriptores hacen la transferencia SPEI
PAYOUT_BANK_NAME="STP"
PAYOUT_CLABE="646180000000000000"
PAYOUT_BENEFICIARY="Tu Nombre"

# Banco emisor/receptor por defecto para validar en el CEP de Banxico
# (el receptor normalmente es tu propio banco, arriba)
BANXICO_CEP_URL="https://www.banxico.org.mx/cep/valida.do"
